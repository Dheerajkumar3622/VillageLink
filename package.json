{
  "name": "villagelink-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database",
    "shared"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run --workspaces --if-present build",
    "start": "npm run --workspace=backend start",
    "dev": "npm run dev --workspaces",
    "dev:frontend": "npm run --workspace=frontend dev",
    "dev:host": "npm run --workspace=frontend dev:host",
    "dev:backend": "npm run --workspace=backend dev"
  }
}