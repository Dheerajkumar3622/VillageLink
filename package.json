{
  "name": "villagelink-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database",
    "shared"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run --workspaces --if-present build",
    "start": "npm run --workspace=backend start",
    "dev": "npm run dev --workspaces",
    "dev:frontend": "npm run --workspace=frontend dev",
    "dev:host": "npm run --workspace=frontend dev:host",
    "dev:backend": "npm run --workspace=backend dev",
    "dev:full": "concurrently -n api,web -c blue,magenta \"npm run dev:backend\" \"wait-on tcp:127.0.0.1:3001 && npm run dev:host\"",
    "nvidia:test": "node scripts/nvidia_opencode_helper.js --test",
    "nvidia:audit": "node scripts/nvidia_code_audit.js",
    "nvidia:self-heal": "node scripts/self_healing_code.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^8.0.1"
  }
}
